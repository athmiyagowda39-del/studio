
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if true; 
      allow create: if true;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    match /leads/{leadId} {
      // A user can read, update, or delete a lead if they are the owner.
      allow get, update, delete: if isSignedIn() && resource.data.subAdminId == request.auth.uid;
      
      // Users can only list leads that are assigned to them.
      // This rule requires a `where("subAdminId", "==", request.auth.uid)` clause in all list queries.
      allow list: if isSignedIn() && request.query.where.subAdminId == request.auth.uid;
      
      // Any authenticated user can create a lead. The client will assign their UID.
      allow create: if isSignedIn();
    }
    
    // This collection is not used. Access is restricted.
    match /roles_sub_admin/{userId} {
      allow read, write: if false;
    }
  }
}
