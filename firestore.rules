
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function documentExists() {
      return resource != null;
    }

    function isAdmin() {
      let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isSignedIn() && userProfile.data.type == 'admin';
    }

    function isAtLeastUser() {
      let userProfile = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isSignedIn() && (userProfile.data.type == 'admin' || userProfile.data.type == 'user');
    }

    function isExistingLeadOwner() {
      return documentExists() && resource.data.subAdminId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if true; 
      allow create: if true;
      allow update: if isOwner(userId) && documentExists() && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    match /leads/{leadId} {
      // Admins can get any lead. Users can only get leads assigned to them.
      allow get: if isAdmin() || (isAtLeastUser() && resource.data.subAdminId == request.auth.uid);
      
      // Admins can list all leads. Users MUST filter by their own subAdminId.
      allow list: if isAdmin() || (isAtLeastUser() && request.query.where.subAdminId == request.auth.uid);
      
      // Any authenticated user can create a lead (it will be assigned to them).
      allow create: if isAtLeastUser();
      
      // Admins or the assigned owner can update or delete a lead.
      allow update, delete: if isAdmin() || isExistingLeadOwner();
    }
    
    // This collection is no longer used for primary role checks.
    // It can be kept for future use or removed. For now, access is restricted.
    match /roles_sub_admin/{userId} {
      allow read, write: if false;
    }
  }
}
