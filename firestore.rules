
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the primary function for validating resource ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the requesting user has the 'Manager' role.
     * This is determined by the existence of a corresponding document in the roles_manager collection.
     */
    function isManager() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_manager/$(request.auth.uid));
    }

    /**
     * Checks if the requesting user is a Manager and directly manages the specified executive.
     * This is used to grant managers read access to their executives' data.
     */
    function isTheirManager(executiveId) {
      return isManager() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/executives/$(executiveId));
    }

    // -------------------------------------------------------------------------
    // User Profile Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // Allow creation for seeding or new user sign-up.
      // Allow owners to get their own data.
      allow create: if true;
      allow get: if isOwner(userId);
      allow list: if false; // Do not allow listing all users.
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Nested collections for Users - grants access to leads, dashboards etc. for the owner
      // or for a manager accessing their executive's data.
       match /leads/{leadId} {
         allow read, write: if isOwner(userId) || isTheirManager(userId);
       }
       match /dashboards/{dashboardId} {
         allow read, write: if isOwner(userId);
       }
       match /executives/{executiveId} {
          allow read, write: if isOwner(userId); // A manager can manage their own list of executives
       }
    }

    // -------------------------------------------------------------------------
    // Manager Role Definition Rules
    // -------------------------------------------------------------------------

    /**
     * This collection is used to identify managers. Its existence is checked by helper functions.
     * It is read-only for clients to prevent privilege escalation. Seeding process can write to it.
     */
    match /roles_manager/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if true; // Allow trusted seeding process
      allow update: if false;
      allow delete: if false;
    }
  }
}
