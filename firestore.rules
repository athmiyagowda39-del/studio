
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function documentExists() {
      return resource != null;
    }
    
    function isLeadOwner() {
      return documentExists() && resource.data.subAdminId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if true; 
      allow create: if true;
      allow update: if isOwner(userId) && documentExists() && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    match /leads/{leadId} {
      // Any authenticated user can get a lead, but only if they are the owner.
      allow get: if isSignedIn() && isLeadOwner();
      
      // Users can only list leads assigned to them.
      // This rule requires a `where("subAdminId", "==", request.auth.uid)` clause in all list queries.
      allow list: if isSignedIn() && request.query.where.subAdminId == request.auth.uid;
      
      // Any authenticated user can create a lead. The client will assign their UID.
      allow create: if isSignedIn();
      
      // Only the assigned owner can update or delete a lead.
      allow update, delete: if isSignedIn() && isLeadOwner();
    }
    
    // This collection is no longer used for primary role checks. Access is restricted.
    match /roles_sub_admin/{userId} {
      allow read, write: if false;
    }
  }
}
