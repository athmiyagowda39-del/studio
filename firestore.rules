
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if true; 
      allow create: if true;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    match /leads/{leadId} {
      // Allow any authenticated user to read, create, update, and delete leads.
      // The application logic is responsible for showing the correct leads to the correct user.
      allow read, write: if isSignedIn();
    }
    
    // This collection is not used. Access is restricted.
    match /roles_sub_admin/{userId} {
      allow read, write: if false;
    }
  }
}
