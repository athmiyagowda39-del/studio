/**
 * Core Philosophy:
 * This ruleset implements a Role-Based Access Control (RBAC) model centered
 * around a "Sub Admin" role. A user's status as a Sub Admin is determined
 * by the existence of a document in the `/roles_sub_admin` collection, which
 * provides a fast and scalable method for role verification.
 *
 * Standard users have ownership-based access, restricted to managing their own
 * user profile. Sub Admins have broader permissions to manage `/leads` documents
 * that are explicitly assigned to them.
 *
 * Data Structure:
 * The data is organized into three distinct top-level collections to segregate
 * concerns and simplify security rules:
 * - /users/{userId}: Stores individual user profile data.
 * - /roles_sub_admin/{userId}: A lookup collection that grants Sub Admin
 *   privileges based on document existence.
 * - /leads/{leadId}: Contains business-critical lead data.
 *
 * Key Security Decisions:
 * - Denormalization for Authorization: To ensure fast and secure access checks,
 *   each document in the `/leads` collection must contain a denormalized
 *   `subAdminId` field. This allows rules to authorize access without needing
 *   slow and costly `get()` calls to other collections.
 * - Secure Listing: Listing all users or all admins is explicitly disallowed
 *   to prevent user enumeration. Sub Admins can only list leads by issuing a
 *   client-side query that filters by their own user ID, which is enforced by
 *   the security rules.
 * - Privileged Operations Lockdown: The ability to grant or revoke Sub Admin
 *   roles (i.e., writing to `/roles_sub_admin`) is locked down by default. This
 *   is a critical security measure that requires explicit implementation of a
 *   higher-level admin system.
 * - Structural Segregation: Separating user profiles (`/users`), roles
 *   (`/roles_sub_admin`), and business data (`/leads`) into different
 *   top-level collections creates a more secure and performant model. This
 *   prevents permission overlaps and simplifies rules for list operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Returns true if the requesting user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the requesting user's UID matches the provided userId.
     * This is the foundation of the user-ownership model.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Returns true if the document being accessed already exists.
     * Crucial for protecting against writes on non-existent documents.
     */
    function documentExists() {
      return resource != null;
    }

    /**
     * Checks for Sub Admin role by verifying the existence of a corresponding
     * document in the roles collection. This is a fast and scalable lookup.
     */
    function isSubAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_sub_admin/$(request.auth.uid));
    }

    /**
     * Verifies ownership for an existing lead document.
     * Combines existence check with ownership check for update/delete operations.
     */
    function isExistingLeadOwner() {
      return documentExists() && resource.data.subAdminId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    /**
     * @description Manages user profiles. Users can create, read, and update
     *   their own profile but cannot view others' profiles or delete their own.
     * @path /users/{userId}
     * @allow (create) A user creating their own profile document.
     *   `db.collection('users').doc('user_abc').set({ id: 'user_abc', ... })`
     * @deny (get) User 'user_abc' trying to read the profile of 'user_xyz'.
     * @principle Restricts access to a user's own data tree (Ownership).
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && documentExists() && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Stores lead data. Only Sub Admins can access leads. Access
     *   is granted if the lead's `subAdminId` field matches the user's UID.
     * @path /leads/{leadId}
     * @allow (list) A Sub Admin querying for leads assigned to them.
     *   `db.collection('leads').where('subAdminId', '==', 'sub_admin_abc').get()`
     * @deny (list) Any user trying to list all leads without a filter.
     * @principle Enforces document ownership for writes and secures list
     *   operations by requiring a query constraint.
     */
    match /leads/{leadId} {
      allow get: if isSubAdmin() && resource.data.subAdminId == request.auth.uid;
      allow list: if isSubAdmin() && request.query.get('subAdminId', '');
      allow create: if isSubAdmin() && request.resource.data.subAdminId == request.auth.uid;
      allow update: if isSubAdmin() && isExistingLeadOwner() && request.resource.data.subAdminId == resource.data.subAdminId;
      allow delete: if isSubAdmin() && isExistingLeadOwner();
    }

    /**
     * @description Defines user roles. The existence of a document here grants
     *   a user Sub Admin privileges throughout the application.
     * @path /roles_sub_admin/{userId}
     * @allow (get) A user checking if they are a Sub Admin.
     *   `db.collection('roles_sub_admin').doc('user_abc').get()`
     * @deny (create) A user attempting to grant themselves Sub Admin privileges.
     * @principle Locks down a critical lookup collection to prevent privilege
     *   escalation. Only a higher-level admin should manage these roles.
     */
    match /roles_sub_admin/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if false; // TODO: Implement a Super Admin role to manage Sub Admin assignments.
      allow update: if false; // TODO: Roles should be managed by a Super Admin, not the user.
      allow delete: if false; // TODO: Role revocation should be managed by a Super Admin.
    }
  }
}
