{
  "entities": {
    "Lead": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Lead",
      "type": "object",
      "description": "Represents a lead generated in the system.",
      "properties": {
        "leadId": {
          "type": "string",
          "description": "Unique identifier for the lead."
        },
        "pincode": { "type": "string" },
        "state": { "type": "string" },
        "district": { "type": "string" },
        "address": { "type": "string" },
        "company": { "type": "string" },
        "contactPerson": { "type": "string" },
        "contactNumber": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "reference": { "type": "string" },
        "headcount": { "type": "string" },
        "sector": { "type": "string" },
        "selectedModule": { "type": "string" },
        "toDealer": { "type": "boolean" },
        "dealer": { "type": "string" },
        "manager": { "type": "string" },
        "executive": { "type": "string" },
        "givenBy": { "type": "string" },
        "status": { "type": "string" },
        "leadSubStatus": { "type": "string" },
        "leadStatusRemarks": { "type": "string" },
        "creationDate": { "type": "number", "description": "Timestamp of creation date" },
        "executiveViewDate": { "type": "number", "description": "Timestamp of when executive viewed" },
        "nextFollowUpDate": { "type": "string", "format": "date-time" },
        "followUps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "number" },
              "date": { "type": "string" },
              "remarks": { "type": "string" },
              "nextFollowUp": { "type": "string" },
              "enteredBy": { "type": "string" }
            }
          }
        },
        "subAdminId": {
          "type": "string",
          "description": "The UID of the sub-admin this lead is assigned to."
        }
      },
      "required": [
        "leadId",
        "pincode",
        "contactPerson",
        "contactNumber",
        "address",
        "creationDate",
        "subAdminId"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "username": {
          "type": "string",
          "description": "The username of the user."
        },
        "type": {
          "type": "string",
          "description": "The type or role of the user (e.g., admin, user)."
        },
        "lastLogin": {
          "type": "string",
          "description": "The date and time of the user's last login.",
          "format": "date-time"
        }
      },
      "required": ["id", "username", "type", "lastLogin"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/entities/User" },
          "description": "Stores user profiles, including role information.",
          "params": [{ "name": "userId", "description": "The unique user ID." }]
        }
      },
      {
        "path": "/leads/{leadId}",
        "definition": {
          "entityName": "Lead",
          "schema": { "$ref": "#/entities/Lead" },
          "description": "Stores all lead data. Each lead includes a `subAdminId` to associate it with a user for access control.",
          "params": [{ "name": "leadId", "description": "The unique lead ID." }]
        }
      }
    ],
    "reasoning": "The Firestore structure is designed for role-based access. User profiles are stored in `/users`. All business-critical lead data is in a top-level `/leads` collection. Each lead document contains a denormalized `subAdminId` field, which is the UID of the user it belongs to. This is crucial for security rules, allowing users to only access leads assigned to them without needing costly cross-collection lookups."
  }
}
